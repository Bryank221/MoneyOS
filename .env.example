# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string used by Drizzle (Supabase "Connection string" -> URI, use the pooled/transaction one for the app, direct one for migrations)
DATABASE_URL=

# Gemini API key for the AI transaction importer (screenshots or PDF statements).
# Get one at https://aistudio.google.com/apikey — server-side only, never
# prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional override; defaults to the cheapest current multimodal model.
GEMINI_MODEL=gemini-2.5-flash-lite
